generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HqRole {
  SUPER_ADMIN
  SUPPORT
  SALES
  BILLING
}

enum SchoolType {
  PRIMARY
  JSS
  SSS
  MIXED
}

enum BillingCycle {
  MONTHLY
  TERMLY
  ANNUAL
}

enum DashboardScope {
  ALL
  PRIMARY
  JSS
  SSS
}

enum Role {
  PRINCIPAL
  ADMIN
  TEACHER
  STUDENT
  PARENT
  FINANCE
}

enum StaffType {
  TEACHING
  NON_TEACHING
  SUPPORT
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PromotionStatus {
  ACTIVE
  PROMOTED
  HELD
  TRANSFERRED
  GRADUATED
}

enum AssessmentType {
  FORMATIVE
  SUMMATIVE
  PROJECT
  EXAM
}

enum CbcGrade {
  EE
  ME
  AE
  BE
}

enum ReportType {
  TERM_REPORT
  ANNUAL_REPORT
}

enum PaymentMethod {
  MPESA
  CASH
  BANK
  CHEQUE
}

enum PaymentStatus {
  PENDING
  PAID
  DISPUTED
}

enum AssignmentType {
  FORM_TEACHER
  SUBJECT_TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PromotionDecision {
  PROMOTED
  HELD
  TRANSFERRED
  GRADUATED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SchoolRole {
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  FINANCE
  ADMIN
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
  WHATSAPP
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SubscriptionPlan {
  planId       String       @id @default(uuid()) @map("plan_id")
  planName     String       @map("plan_name")
  maxStudents  Int          @map("max_students")
  maxStaff     Int          @map("max_staff")
  storageGb    Float        @map("storage_gb")
  priceKes     Float        @map("price_kes")
  billingCycle BillingCycle @map("billing_cycle")
  featuresJson String?      @map("features_json")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")

  tenants Tenant[]

  @@map("subscription_plans")
}

model PlatformUser {
  platformUserId String    @id @default(uuid()) @map("platform_user_id")
  fullName       String    @map("full_name")
  email          String    @unique
  passwordHash   String    @map("password_hash")
  hqRole         HqRole    @map("hq_role")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  avatarUrl      String?   @map("avatar_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenants               Tenant[]                    @relation("TenantOnboardedBy")
  dashboardAssignments  TenantDashboardAssignment[]
  featureAssignments    TenantFeatureAssignment[]
  receivedNotifications Notification[]              @relation("PlatformUserNotifications")
  auditLogs             AuditLog[]                  @relation("PlatformUserAuditLogs")

  @@map("platform_users")
}

model Tenant {
  tenantId       String     @id @default(uuid()) @map("tenant_id")
  schoolName     String     @map("school_name")
  subdomain      String     @unique
  county         String
  subCounty      String?    @map("sub_county")
  schoolType     SchoolType @map("school_type")
  registrationNo String     @unique @map("registration_no")
  planId         String     @map("plan_id")
  isActive       Boolean    @default(true) @map("is_active")
  onboardedAt    DateTime   @default(now()) @map("onboarded_at")
  onboardedBy    String?    @map("onboarded_by")
  timezone       String     @default("Africa/Nairobi")
  logoUrl        String?    @map("logo_url")
  contactEmail   String     @map("contact_email")
  contactPhone   String     @map("contact_phone")
  address        String?
  motto          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  plan                    SubscriptionPlan            @relation(fields: [planId], references: [planId])
  onboardedUser           PlatformUser?               @relation("TenantOnboardedBy", fields: [onboardedBy], references: [platformUserId])
  dashboards              TenantDashboardAssignment[]
  featureAssignments      TenantFeatureAssignment[]
  visibility              SchoolRoleVisibility[]
  years                   AcademicYear[]
  tiers                   EducationTier[]
  classes                 Class[]
  subjects                Subject[]
  users                   User[]
  staff                   Staff[]
  students                Student[]
  parents                 Parent[]
  terms                   Term[]
  classSubjectAssignments ClassSubjectAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  attendance              Attendance[]
  assignments             Assignment[]
  marks                   Mark[]
  cbcCompetencies         CbcCompetency[]
  portfolios              StudentPortfolio[]
  reports                 Report[]
  studentPromotions       StudentPromotion[]
  feeStructures           FeeStructure[]
  feePayments             FeePayment[]
  paymentIntents          PaymentIntent[]
  paymentAllocations      PaymentAllocation[]
  receipts                Receipt[]
  mpesaRequests           MpesaRequest[]
  mpesaCallbacks          MpesaCallback[]
  expenses                Expense[]
  payrolls                Payroll[]
  timetableEntries        TimetableEntry[]
  messageThreads          MessageThread[]
  messageParticipants     MessageParticipant[]
  messages                Message[]
  mpesaTransactions       MpesaTransaction[]
  parentStudentLinks      ParentStudentLink[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  systemEvents            SystemEvent[]
  chatRooms               ChatRoom[]
  chatRoomMembers         ChatRoomMember[]
  chatMessages            ChatMessage[]
  chatMessageReactions    ChatMessageReaction[]
  chatMentions            ChatMention[]
  chatAttachments         ChatAttachment[]
  chatReadReceipts        ChatReadReceipt[]
  chatPins                ChatPin[]
  invitations             Invitation[]
  chatMuteSettings        ChatMuteSetting[]
  chatMessageEdits        ChatMessageEdit[]
  chatMessageDeletes      ChatMessageDelete[]

  @@map("tenants")
}

model PlatformDashboard {
  dashboardId   String         @id @default(uuid()) @map("dashboard_id")
  dashboardKey  String         @unique @map("dashboard_key")
  dashboardName String         @map("dashboard_name")
  tierScope     DashboardScope @map("tier_scope")
  icon          String?
  description   String?
  isActive      Boolean        @default(true) @map("is_active")

  features       PlatformFeature[]
  assignments    TenantDashboardAssignment[]
  tenantFeatures TenantFeatureAssignment[]

  @@map("platform_dashboards")
}

model PlatformFeature {
  featureId   String  @id @default(uuid()) @map("feature_id")
  featureKey  String  @unique @map("feature_key")
  featureName String  @map("feature_name")
  dashboardId String  @map("dashboard_id")
  moduleGroup String  @map("module_group")
  isCore      Boolean @default(false) @map("is_core")
  description String?
  isActive    Boolean @default(true) @map("is_active")

  dashboard         PlatformDashboard         @relation(fields: [dashboardId], references: [dashboardId])
  tenantAssignments TenantFeatureAssignment[]

  @@map("platform_features")
}

model TenantDashboardAssignment {
  assignmentId String    @id @default(uuid()) @map("assignment_id")
  tenantId     String    @map("tenant_id")
  dashboardId  String    @map("dashboard_id")
  isEnabled    Boolean   @default(true) @map("is_enabled")
  assignedBy   String    @map("assigned_by")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  expiresAt    DateTime? @map("expires_at")
  notes        String?

  tenant    Tenant            @relation(fields: [tenantId], references: [tenantId])
  dashboard PlatformDashboard @relation(fields: [dashboardId], references: [dashboardId])
  assignee  PlatformUser      @relation(fields: [assignedBy], references: [platformUserId])

  @@unique([tenantId, dashboardId])
  @@map("tenant_dashboard_assignments")
}

model TenantFeatureAssignment {
  tfaId          String    @id @default(uuid()) @map("tfa_id")
  tenantId       String    @map("tenant_id")
  dashboardId    String    @map("dashboard_id")
  featureId      String    @map("feature_id")
  isEnabled      Boolean   @default(true) @map("is_enabled")
  enabledByHq    Boolean   @default(true) @map("enabled_by_hq")
  assignedBy     String    @map("assigned_by")
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  lastToggledAt  DateTime? @map("last_toggled_at")
  lastToggledBy  String?   @map("last_toggled_by")
  overrideReason String?   @map("override_reason")

  tenant                 Tenant                 @relation(fields: [tenantId], references: [tenantId])
  dashboard              PlatformDashboard      @relation(fields: [dashboardId], references: [dashboardId])
  feature                PlatformFeature        @relation(fields: [featureId], references: [featureId])
  assignee               PlatformUser           @relation(fields: [assignedBy], references: [platformUserId])
  schoolRoleVisibilities SchoolRoleVisibility[]

  @@unique([tenantId, dashboardId, featureId])
  @@map("tenant_feature_assignments")
}

model SchoolRoleVisibility {
  visibilityId String     @id @default(uuid()) @map("visibility_id")
  tenantId     String     @map("tenant_id")
  tfaId        String     @map("tfa_id")
  roleKey      SchoolRole @map("role_key")
  isVisible    Boolean    @default(true) @map("is_visible")
  setBy        String     @map("set_by")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant Tenant                  @relation(fields: [tenantId], references: [tenantId])
  tfa    TenantFeatureAssignment @relation(fields: [tfaId], references: [tfaId])

  @@unique([tenantId, tfaId, roleKey])
  @@map("school_role_visibility")
}

model AcademicYear {
  yearId    String   @id @default(uuid()) @map("year_id")
  tenantId  String   @map("tenant_id")
  yearLabel String   @map("year_label")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [tenantId])
  terms                   Term[]
  classes                 Class[]
  classSubjectAssignments ClassSubjectAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  promotionsFrom          StudentPromotion[]       @relation("FromYear")
  promotionsTo            StudentPromotion[]       @relation("ToYear")
  timetableEntries        TimetableEntry[]
  feeStructures           FeeStructure[]
  expenses                Expense[]
  payroll                 Payroll[]

  @@map("academic_years")
}

model Term {
  termId     String   @id @default(uuid()) @map("term_id")
  tenantId   String   @map("tenant_id")
  yearId     String   @map("year_id")
  termNumber Int      @map("term_number")
  termName   String   @map("term_name")
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  isCurrent  Boolean  @default(false) @map("is_current")

  tenant            Tenant             @relation(fields: [tenantId], references: [tenantId])
  year              AcademicYear       @relation(fields: [yearId], references: [yearId])
  attendances       Attendance[]
  assignments       Assignment[]
  marks             Mark[]
  cbcCompetencies   CbcCompetency[]
  studentPortfolios StudentPortfolio[]
  reports           Report[]
  timetableEntries  TimetableEntry[]
  feeStructures     FeeStructure[]

  @@map("terms")
}

model EducationTier {
  tierId    String  @id @default(uuid()) @map("tier_id")
  tenantId  String  @map("tenant_id")
  tierKey   String  @map("tier_key")
  tierName  String  @map("tier_name")
  gradeFrom String  @map("grade_from")
  gradeTo   String  @map("grade_to")
  isActive  Boolean @default(true) @map("is_active")

  tenant        Tenant         @relation(fields: [tenantId], references: [tenantId])
  classes       Class[]
  subjects      Subject[]
  students      Student[]
  feeStructures FeeStructure[]

  @@map("education_tiers")
}

model Class {
  classId   String   @id @default(uuid()) @map("class_id")
  tenantId  String   @map("tenant_id")
  tierId    String   @map("tier_id")
  yearId    String   @map("year_id")
  grade     String
  stream    String?
  className String   @map("class_name")
  capacity  Int?     @default(40)
  createdAt DateTime @default(now()) @map("created_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [tenantId])
  tier                    EducationTier            @relation(fields: [tierId], references: [tierId])
  year                    AcademicYear             @relation(fields: [yearId], references: [yearId])
  students                Student[]
  assignments             Assignment[]
  attendance              Attendance[]
  classSubjectAssignments ClassSubjectAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  promotionsFrom          StudentPromotion[]       @relation("FromClass")
  promotionsTo            StudentPromotion[]       @relation("ToClass")
  timetableEntries        TimetableEntry[]
  marks                   Mark[]
  reports                 Report[]
  chatRooms               ChatRoom[]

  @@map("classes")
}

model Subject {
  subjectId       String  @id @default(uuid()) @map("subject_id")
  tenantId        String  @map("tenant_id")
  tierId          String  @map("tier_id")
  subjectName     String  @map("subject_name")
  subjectCode     String? @map("subject_code")
  cbcLearningArea String? @map("cbc_learning_area")
  isCore          Boolean @default(true) @map("is_core")
  isActive        Boolean @default(true) @map("is_active")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [tenantId])
  tier                    EducationTier            @relation(fields: [tierId], references: [tierId])
  classSubjectAssignments ClassSubjectAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  assignments             Assignment[]
  marks                   Mark[]
  studentPortfolios       StudentPortfolio[]
  timetableEntries        TimetableEntry[]
  chatRooms               ChatRoom[]

  @@map("subjects")
}

model ClassSubjectAssignment {
  csaId     String  @id @default(uuid()) @map("csa_id")
  tenantId  String  @map("tenant_id")
  classId   String  @map("class_id")
  subjectId String  @map("subject_id")
  yearId    String  @map("year_id")
  isActive  Boolean @default(true) @map("is_active")

  tenant  Tenant       @relation(fields: [tenantId], references: [tenantId])
  class   Class        @relation(fields: [classId], references: [classId])
  subject Subject      @relation(fields: [subjectId], references: [subjectId])
  year    AcademicYear @relation(fields: [yearId], references: [yearId])

  @@unique([tenantId, classId, subjectId, yearId])
  @@map("class_subject_assignments")
}

model User {
  userId       String    @id @default(uuid()) @map("user_id")
  tenantId     String    @map("tenant_id")
  email        String
  phone        String?
  passwordHash String    @map("password_hash")
  role         Role
  fullName     String?   @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  profileRefId String?   @map("profile_ref_id")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant                  Tenant               @relation(fields: [tenantId], references: [tenantId])
  staff                   Staff?
  student                 Student?
  parent                  Parent?
  generatedReports        Report[]             @relation("ReportGeneratedBy")
  approvedReports         Report[]             @relation("ReportApprovedBy")
  recordedExpenses        Expense[]            @relation("ExpenseRecordedBy")
  approvedExpenses        Expense[]            @relation("ExpenseApprovedBy")
  processedPayrolls       Payroll[]
  sentMessages            Message[]            @relation("MessageSender")
  receivedNotifications   Notification[]       @relation("UserNotifications")
  auditLogs               AuditLog[]           @relation("UserAuditLogs")
  createdThreads          MessageThread[]      @relation("ThreadCreator")
  timetableEntriesCreated TimetableEntry[]     @relation("TimetableCreator")
  markedAttendances       Attendance[]
  createdAssignments      Assignment[]
  enteredMarks            Mark[]
  uploadedPortfolios      StudentPortfolio[]
  mpesaTransactions       MpesaTransaction[]
  cbcCompetencies         CbcCompetency[]
  studentPromotions       StudentPromotion[]
  feePayments             FeePayment[]
  messageParticipants     MessageParticipant[]
  createdInvitations      Invitation[]         @relation("createdInvitations")

  @@unique([tenantId, email])
  @@map("users")
}

model Staff {
  staffId        String         @id @default(uuid()) @map("staff_id")
  tenantId       String         @map("tenant_id")
  userId         String?        @unique @map("user_id")
  tscNumber      String?        @map("tsc_number")
  fullName       String         @map("full_name")
  nationalId     String         @unique @map("national_id")
  staffType      StaffType      @map("staff_type")
  specialization String?
  employmentType EmploymentType @map("employment_type")
  joinedDate     DateTime       @map("joined_date")
  phone          String?
  email          String?
  isActive       Boolean        @default(true) @map("is_active")

  tenant           Tenant                   @relation(fields: [tenantId], references: [tenantId])
  user             User?                    @relation(fields: [userId], references: [userId])
  assignments      ClassTeacherAssignment[]
  payrolls         Payroll[]
  timetableEntries TimetableEntry[]

  @@map("staff")
}

model ClassTeacherAssignment {
  ctaId          String         @id @default(uuid()) @map("cta_id")
  tenantId       String         @map("tenant_id")
  classId        String         @map("class_id")
  staffId        String         @map("staff_id")
  yearId         String         @map("year_id")
  assignmentType AssignmentType @map("assignment_type")
  subjectId      String?        @map("subject_id")
  assignedAt     DateTime       @default(now()) @map("assigned_at")
  isActive       Boolean        @default(true) @map("is_active")

  tenant  Tenant       @relation(fields: [tenantId], references: [tenantId])
  class   Class        @relation(fields: [classId], references: [classId])
  staff   Staff        @relation(fields: [staffId], references: [staffId])
  year    AcademicYear @relation(fields: [yearId], references: [yearId])
  subject Subject?     @relation(fields: [subjectId], references: [subjectId])

  @@unique([tenantId, classId, staffId, yearId, assignmentType, subjectId])
  @@map("class_teacher_assignments")
}

model Student {
  studentId       String          @id @default(uuid()) @map("student_id")
  tenantId        String          @map("tenant_id")
  userId          String?         @unique @map("user_id")
  nemisNumber     String          @unique @map("nemis_number")
  fullName        String          @map("full_name")
  dateOfBirth     DateTime        @map("date_of_birth")
  gender          Gender
  classId         String          @map("class_id")
  admissionNumber String          @map("admission_number")
  admittedDate    DateTime        @map("admitted_date")
  currentGrade    String          @map("current_grade")
  tierId          String          @map("tier_id")
  promotionStatus PromotionStatus @default(ACTIVE) @map("promotion_status")
  isActive        Boolean         @default(true) @map("is_active")

  tenant            Tenant              @relation(fields: [tenantId], references: [tenantId])
  user              User?               @relation(fields: [userId], references: [userId])
  class             Class               @relation(fields: [classId], references: [classId])
  tier              EducationTier       @relation(fields: [tierId], references: [tierId])
  marks             Mark[]
  attendance        Attendance[]
  portfolios        StudentPortfolio[]
  competencies      CbcCompetency[]
  reports           Report[]
  payments          FeePayment[]
  parentLinks       ParentStudentLink[]
  mpesaTransactions MpesaTransaction[]
  studentPromotions StudentPromotion[]
  paymentIntents    PaymentIntent[]

  @@map("students")
}

model Parent {
  parentId       String  @id @default(uuid()) @map("parent_id")
  tenantId       String  @map("tenant_id")
  userId         String? @unique @map("user_id")
  fullName       String  @map("full_name")
  nationalId     String? @map("national_id")
  phonePrimary   String  @map("phone_primary")
  phoneSecondary String? @map("phone_secondary")
  relationship   String

  tenant Tenant              @relation(fields: [tenantId], references: [tenantId])
  user   User?               @relation(fields: [userId], references: [userId])
  links  ParentStudentLink[]

  @@map("parents")
}

model ParentStudentLink {
  linkId           String  @id @default(uuid()) @map("link_id")
  tenantId         String  @map("tenant_id")
  parentId         String  @map("parent_id")
  studentId        String  @map("student_id")
  isPrimaryContact Boolean @default(false) @map("is_primary_contact")
  canViewResults   Boolean @default(true) @map("can_view_results")
  canViewFees      Boolean @default(true) @map("can_view_fees")

  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId])
  parent  Parent  @relation(fields: [parentId], references: [parentId])
  student Student @relation(fields: [studentId], references: [studentId])

  @@unique([tenantId, parentId, studentId])
  @@map("parent_student_links")
}

model Attendance {
  attendanceId   String           @id @default(uuid()) @map("attendance_id")
  tenantId       String           @map("tenant_id")
  studentId      String           @map("student_id")
  classId        String           @map("class_id")
  termId         String           @map("term_id")
  attendanceDate DateTime         @map("attendance_date")
  status         AttendanceStatus
  markedBy       String           @map("marked_by")
  markedAt       DateTime         @default(now()) @map("marked_at")
  notes          String?

  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId])
  student Student @relation(fields: [studentId], references: [studentId])
  class   Class   @relation(fields: [classId], references: [classId])
  term    Term    @relation(fields: [termId], references: [termId])
  marker  User    @relation(fields: [markedBy], references: [userId])

  @@unique([tenantId, studentId, attendanceDate, classId])
  @@map("attendance")
}

model Assignment {
  assignmentId String    @id @default(uuid()) @map("assignment_id")
  tenantId     String    @map("tenant_id")
  classId      String    @map("class_id")
  subjectId    String    @map("subject_id")
  termId       String    @map("term_id")
  title        String
  description  String?
  dueDate      DateTime? @map("due_date")
  maxScore     Float?    @default(100) @map("max_score")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  isPublished  Boolean   @default(true) @map("is_published")

  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId])
  class   Class   @relation(fields: [classId], references: [classId])
  subject Subject @relation(fields: [subjectId], references: [subjectId])
  term    Term    @relation(fields: [termId], references: [termId])
  creator User    @relation(fields: [createdBy], references: [userId])

  @@map("assignments")
}

model Mark {
  markId         String         @id @default(uuid()) @map("mark_id")
  tenantId       String         @map("tenant_id")
  studentId      String         @map("student_id")
  subjectId      String         @map("subject_id")
  classId        String         @map("class_id")
  termId         String         @map("term_id")
  assessmentType AssessmentType @map("assessment_type")
  rawScore       Float?         @map("raw_score")
  cbcGrade       CbcGrade?      @map("cbc_grade")
  maxScore       Float?         @default(100) @map("max_score")
  enteredBy      String         @map("entered_by")
  enteredAt      DateTime       @default(now()) @map("entered_at")
  isPublished    Boolean        @default(false) @map("is_published")
  publishedAt    DateTime?      @map("published_at")

  tenant        Tenant  @relation(fields: [tenantId], references: [tenantId])
  student       Student @relation(fields: [studentId], references: [studentId])
  subject       Subject @relation(fields: [subjectId], references: [subjectId])
  class         Class   @relation(fields: [classId], references: [classId])
  term          Term    @relation(fields: [termId], references: [termId])
  enteredByUser User    @relation(fields: [enteredBy], references: [userId])

  @@map("marks")
}

model CbcCompetency {
  competencyId   String   @id @default(uuid()) @map("competency_id")
  tenantId       String   @map("tenant_id")
  studentId      String   @map("student_id")
  termId         String   @map("term_id")
  competencyArea String   @map("competency_area")
  level          CbcGrade
  notes          String?
  assessedBy     String   @map("assessed_by")
  assessedAt     DateTime @default(now()) @map("assessed_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [tenantId])
