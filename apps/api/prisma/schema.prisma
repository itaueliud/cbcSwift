  tenant  Tenant      @relation(fields: [tenantId], references: [tenantId])
  room    ChatRoom    @relation(fields: [roomId], references: [roomId])
  message ChatMessage @relation(fields: [messageId], references: [messageId])

  @@index([tenantId, roomId])
  @@map("chat_pins")
}

model ChatMuteSetting {
  muteId         String    @id @default(uuid()) @map("mute_id")
  tenantId       String    @map("tenant_id")
  roomId         String    @map("room_id")
  userId         String?   @map("user_id")
  platformUserId String?   @map("platform_user_id")
  mutedUntil     DateTime? @map("muted_until")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [tenantId])
  room   ChatRoom @relation(fields: [roomId], references: [roomId])

  @@unique([roomId, userId, platformUserId])
  @@map("chat_mute_settings")
}

model ChatMessageEdit {
  editId               String   @id @default(uuid()) @map("edit_id")
  tenantId             String   @map("tenant_id")
  messageId            String   @map("message_id")
  editorUserId         String?  @map("editor_user_id")
  editorPlatformUserId String?  @map("editor_platform_user_id")
  newContent           String   @map("new_content")
  editedAt             DateTime @default(now()) @map("edited_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [tenantId])
  message ChatMessage @relation(fields: [messageId], references: [messageId])

  @@index([tenantId, messageId, editedAt])
  @@map("chat_message_edits")
}

model ChatMessageDelete {
  deleteId                String   @id @default(uuid()) @map("delete_id")
  tenantId                String   @map("tenant_id")
  messageId               String   @map("message_id")
  deletedByUserId         String?  @map("deleted_by_user_id")
  deletedByPlatformUserId String?  @map("deleted_by_platform_user_id")
  reason                  String?
  deletedAt               DateTime @default(now()) @map("deleted_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [tenantId])
  message ChatMessage @relation(fields: [messageId], references: [messageId])

  @@index([tenantId, messageId, deletedAt])
  @@map("chat_message_deletes")
}

model MpesaTransaction {
  transactionId String   @id @default(uuid()) @map("transaction_id")
  tenantId      String   @map("tenant_id")
  paymentId     String?  @map("payment_id")
  studentId     String?  @map("student_id")
  phoneNumber   String   @map("phone_number")
  amount        Float
  mpesaCode     String?  @map("mpesa_code")
  status        String
  rawPayload    String?  @map("raw_payload")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [tenantId])
  payment    FeePayment? @relation(fields: [paymentId], references: [paymentId])
  student    Student?    @relation(fields: [studentId], references: [studentId])
  user       User?       @relation(fields: [userUserId], references: [userId])
  userUserId String?

  @@map("mpesa_transactions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

// ── 2FA / Security ──────────────────────────────────────────────────────────

model TwoFactorSetup {
  twoFaId          String    @id @default(uuid()) @map("two_fa_id")
  userId           String?   @unique @map("user_id")
  platformUserId   String?   @unique @map("platform_user_id")
  secret           String
  isEnabled        Boolean   @default(false) @map("is_enabled")
  setupCompletedAt DateTime? @map("setup_completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("two_factor_setups")
}

model TwoFactorRecoveryCode {
  codeId    String    @id @default(uuid()) @map("code_id")
  userId    String?   @map("user_id")
  platformUserId String? @map("platform_user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("two_factor_recovery_codes")
}

model TrustedDevice {
  deviceId     String   @id @default(uuid()) @map("device_id")
  userId       String?  @map("user_id")
  platformUserId String? @map("platform_user_id")
  deviceToken  String   @unique @map("device_token")
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("trusted_devices")
}

// ── Invitation System ────────────────────────────────────────────────────────

model Invitation {
  invitationId String    @id @default(uuid()) @map("invitation_id")
  tenantId     String    @map("tenant_id")
  email        String
  fullName     String    @map("full_name")
  role         Role
  tokenHash    String    @unique @map("token_hash")
  isUsed       Boolean   @default(false) @map("is_used")
  expiresAt    DateTime  @map("expires_at")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  usedAt       DateTime? @map("used_at")
  additionalData Json?   @map("additional_data")

  tenant Tenant @relation(fields: [tenantId], references: [tenantId])
  creator User  @relation(fields: [createdBy], references: [userId], name: "createdInvitations")

  @@map("invitations")
}


// ── AI Bot ──────────────────────────────────────────────────────────────────

model BotConversation {
  conversationId String   @id @default(uuid()) @map("conversation_id")
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  role           String
  messages       Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("bot_conversations")
}
